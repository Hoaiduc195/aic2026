# Cloudflare R2 S3-compatible connection settings.
# Copy this file to tmp/.env locally and replace the placeholder values.
# The migration script loads tmp/.env automatically.
# Never commit the real .env file or any R2 credentials.

R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

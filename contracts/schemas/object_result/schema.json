{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/object_result/schema.json",
  "title": "ObjectResult",
  "description": "Selected-frame object evidence for counting, grounding, and temporal tracking.",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "segment_id", "timestamp_ms", "objects"],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "original_frame_id": { "type": "integer", "minimum": 0 },
    "frame_id": { "type": "string", "minLength": 1, "description": "Optional legacy/adapter frame identity." },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "box", "confidence"],
        "properties": {
          "class": { "type": "string", "minLength": 1 },
          "class_id": { "type": "integer", "minimum": 0 },
          "canonical_label": { "type": "string", "minLength": 1 },
          "box": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 4, "maxItems": 4 },
          "normalized_box": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 4, "maxItems": 4 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "track_id": { "type": ["string", "null"], "minLength": 1 },
          "attributes": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "producer": { "type": "string", "minLength": 1 },
    "model_version": { "type": ["string", "null"], "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  },
  "anyOf": [
    { "required": ["frame_id"] },
    { "required": ["original_frame_id", "producer"] }
  ]
}

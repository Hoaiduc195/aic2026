{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/object_result/schema.json",
  "title": "ObjectResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_id",
    "segment_id",
    "frame_id",
    "timestamp_ms",
    "objects"
  ],
  "properties": {
    "video_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": "string", "minLength": 1 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "box", "confidence"],
        "properties": {
          "class": { "type": "string" },
          "box": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}

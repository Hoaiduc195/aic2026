{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/version_manifest/schema.json",
  "title": "VersionManifest",
  "description": "The compatibility tuple every indexed response must identify.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "dataset_version", "pipeline_version", "schema_version", "index_version", "model_versions", "created_at", "status"],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "index_version": { "type": "string", "minLength": 1 },
    "model_versions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "compatible_schema_versions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["staged", "active", "retired"] },
    "build_config": { "type": "object", "additionalProperties": true }
  }
}

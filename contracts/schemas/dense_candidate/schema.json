{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/dense_candidate/schema.json",
  "title": "DenseAlignmentCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_window_id",
    "video_id",
    "original_frame_id",
    "timestamp_ms",
    "decode_status"
  ],
  "properties": {
    "event_window_id": { "type": "string", "minLength": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "query_id": { "type": ["string", "null"], "minLength": 1 },
    "event_id": { "type": ["string", "null"], "minLength": 1 },
    "event_ordinal": { "type": ["integer", "null"], "minimum": 1 },
    "original_frame_id": { "type": "integer", "minimum": 0 },
    "timestamp_ms": { "type": "number", "minimum": 0 },
    "decode_status": { "enum": ["success", "decode_error"] },
    "pts": { "type": ["integer", "null"] },
    "decode_method": { "type": ["string", "null"], "minLength": 1 },
    "quality_scores": { "type": "object", "additionalProperties": { "type": "number" } },
    "event_score": { "type": ["number", "null"] },
    "event_score_provenance": { "type": ["object", "null"], "additionalProperties": true },
    "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidence": { "type": "object", "additionalProperties": true },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}

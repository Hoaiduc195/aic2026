{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/qualification_request/schema.json",
  "title": "QualificationRequest",
  "description": "Internal task request for the preliminary-round Textual KIS, VQA/Q&A, or TRAKE workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "query_id", "task", "dataset_version", "top_k", "latency_budget_ms"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "query_id": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "enum": ["textual_kis", "vqa", "trake"] },
    "description": { "type": "string", "minLength": 1 },
    "event_description": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_ordinal", "description"],
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "event_ordinal": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1 },
          "event_label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dataset_version": { "type": "string", "minLength": 1 },
    "top_k": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "latency_budget_ms": { "type": "integer", "minimum": 1 },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "video_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "end_ms": { "type": ["integer", "null"], "minimum": 0 },
        "languages": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "language": { "type": ["string", "null"], "minLength": 1 },
    "include_debug": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "task": { "const": "textual_kis" } } },
      "then": { "required": ["description"] }
    },
    {
      "if": { "properties": { "task": { "const": "vqa" } } },
      "then": { "required": ["event_description", "question"] }
    },
    {
      "if": { "properties": { "task": { "const": "trake" } } },
      "then": { "required": ["events"] }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/textual_kis_response/schema.json",
  "title": "TextualKisResponse",
  "description": "One exact source-frame candidate for Textual Known Item Search.",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "query_id", "video_id", "original_frame_id", "timestamp_ms", "score", "evidence_ids", "confidence"],
  "properties": {
    "result_id": { "type": "string", "minLength": 1 },
    "query_id": { "type": "string", "minLength": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "original_frame_id": { "type": "integer", "minimum": 0 },
    "frame_id": { "type": "string", "minLength": 1, "description": "Optional organizer/legacy identifier; original_frame_id is authoritative internally." },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "preview_uri": { "type": ["string", "null"], "pattern": "^(file|s3|r2|gs|azure|https?)://[^\\s?#]+$" },
    "score": { "type": "number" },
    "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "object", "additionalProperties": false, "required": ["level", "score"], "properties": { "level": { "type": "string", "enum": ["high", "medium", "low", "unknown"] }, "score": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "producer": { "type": "string", "minLength": 1 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic2026.local/contracts/schemas/evidence_record/schema.json",
  "title": "EvidenceRecord",
  "type": "object", "additionalProperties": false,
  "required": ["evidence_id", "video_id", "temporal_node_id", "evidence_type", "start_ms", "end_ms", "payload", "confidence", "producer", "provenance", "versions"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "temporal_node_id": {"type": "string", "minLength": 1},
    "evidence_type": {"enum": ["visual", "ocr", "asr", "caption", "object", "audio"]},
    "start_ms": {"type": "integer", "minimum": 0},
    "end_ms": {"type": "integer", "minimum": 1},
    "payload": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "code_version", "model_family", "model_revision"],
      "properties": {
        "stage": {"type": "string", "minLength": 1}, "code_version": {"type": "string", "minLength": 1},
        "model_family": {"type": ["string", "null"]}, "model_revision": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "artifact_uri", "artifact_checksum"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "artifact_uri": {"type": "string", "pattern": "^(s3|https?|file)://"},
        "artifact_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "versions": {"$ref": "https://aic2026.local/contracts/schemas/version_manifest/schema.json"}
  }
}

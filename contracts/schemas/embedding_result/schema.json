{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/embedding_result/schema.json",
  "title": "EmbeddingResult",
  "description": "Versioned embedding reference tied to an exact source frame.",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "segment_id", "timestamp_ms", "embedding_id", "embedding_uri", "embedding_dim", "model_name", "model_version"],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "original_frame_id": { "type": "integer", "minimum": 0 },
    "frame_id": { "type": "string", "minLength": 1, "description": "Optional legacy/adapter frame identity." },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "embedding_id": { "type": "string", "minLength": 1 },
    "embedding_uri": { "type": "string", "pattern": "^(file|s3|r2|gs|azure|https?)://[^\\s?#]+$" },
    "embedding_dim": { "type": "integer", "minimum": 1 },
    "dtype": { "type": "string", "enum": ["float16", "float32", "int8"] },
    "normalized": { "type": "boolean" },
    "model_name": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  },
  "anyOf": [
    { "required": ["frame_id"] },
    { "required": ["original_frame_id"] }
  ]
}

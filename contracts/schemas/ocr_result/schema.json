{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/ocr_result/schema.json",
  "title": "OcrResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_id",
    "segment_id",
    "frame_id",
    "timestamp_ms",
    "text",
    "boxes",
    "confidence"
  ],
  "properties": {
    "video_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": "string", "minLength": 1 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "text": { "type": "string" },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "box", "confidence"],
        "properties": {
          "text": { "type": "string" },
          "box": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}

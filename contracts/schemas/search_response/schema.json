{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic2026.local/contracts/schemas/search_response/schema.json",
  "title": "SearchResponse",
  "type": "object", "additionalProperties": false,
  "required": ["request_id", "query_id", "query", "task", "executor", "versions", "confidence", "degraded", "unavailable_branches", "branches", "results", "timing_ms"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1}, "query_id": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1},
    "task": {"enum": ["textual_kis", "video_kis", "avs", "vqa", "kisc"]}, "executor": {"type": "string", "minLength": 1},
    "versions": {"$ref": "https://aic2026.local/contracts/schemas/version_manifest/schema.json"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "degraded": {"type": "boolean"},
    "unavailable_branches": {"type": "array", "uniqueItems": true, "items": {"enum": ["visual", "ocr", "asr", "caption", "object", "audio"]}},
    "branches": {"type": "array", "items": {"$ref": "https://aic2026.local/contracts/schemas/branch_result/schema.json"}},
    "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["segment_id", "video_id", "start_ms", "end_ms", "preview_uri", "score", "evidence_ids", "matched_modalities", "versions"], "properties": {
      "segment_id": {"type": "string", "minLength": 1}, "video_id": {"type": "string", "minLength": 1},
      "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1},
      "preview_uri": {"type": "string", "pattern": "^(s3|https?|file)://"}, "score": {"type": "number"},
      "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "matched_modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["visual", "ocr", "asr", "caption", "object", "audio"]}},
      "versions": {"$ref": "https://aic2026.local/contracts/schemas/version_manifest/schema.json"}
    }}},
    "timing_ms": {"type": "object", "additionalProperties": false, "required": ["planning", "retrieval", "fusion", "total"], "properties": {"planning": {"type": "integer", "minimum": 0}, "retrieval": {"type": "integer", "minimum": 0}, "fusion": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}}
  },
  "allOf": [{"if": {"properties": {"degraded": {"const": false}}}, "then": {"properties": {"unavailable_branches": {"maxItems": 0}}}}]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/asr_result/schema.json",
  "title": "AsrResult",
  "type": "object",
  "additionalProperties": false,
  "description": "ASR is an interval evidence record, not a frame attribute. Canonical fields are start_ms/end_ms and raw/normalized text; legacy asr_* and text fields remain accepted in v1.",
  "required": ["video_id", "segment_id", "confidence"],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "asr_start_ms": { "type": "integer", "minimum": 0 },
    "asr_end_ms": { "type": "integer", "minimum": 0 },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 1 },
    "start_frame_id": { "type": ["integer", "null"], "minimum": 0 },
    "end_frame_id": { "type": ["integer", "null"], "minimum": 0 },
    "text": { "type": "string" },
    "text_raw": { "type": "string" },
    "text_normalized": { "type": "string" },
    "language": { "type": ["string", "null"], "minLength": 1 },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "start_ms", "end_ms", "confidence"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    ,"no_speech_probability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
    ,"producer": { "type": "string", "minLength": 1 }
    ,"model_version": { "type": ["string", "null"], "minLength": 1 }
    ,"pipeline_version": { "type": "string", "minLength": 1 }
    ,"schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
    ,"quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asr_confidence", "dnsmos_sig", "dnsmos_bak", "dnsmos_ovrl", "ready", "suggestions"],
      "properties": {
        "asr_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "dnsmos_sig": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "dnsmos_bak": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "dnsmos_ovrl": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "ready": { "type": ["boolean", "null"] },
        "suggestions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "anyOf": [
    { "required": ["asr_start_ms", "asr_end_ms", "text"] },
    { "required": ["start_ms", "end_ms", "text_raw", "text_normalized", "producer"] }
  ]
}

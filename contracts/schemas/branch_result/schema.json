{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/branch_result/schema.json",
  "title": "BranchResult",
  "description": "Normalized output of one isolated retrieval branch. Failed branches never publish partial candidates as completed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "branch", "status", "query_variant", "candidates", "elapsed_ms", "deadline_ms", "index_version", "producer"],
  "properties": {
    "query_id": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "enum": ["visual", "ocr_lexical", "ocr_semantic", "asr_lexical", "asr_semantic", "caption", "object", "temporal", "clip", "audio"] },
    "status": { "type": "string", "enum": ["completed", "timed_out", "unavailable", "failed", "skipped_by_plan"] },
    "query_variant": { "type": ["string", "null"] },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "original_frame_id", "rank", "raw_score", "evidence_ids"],
        "properties": {
          "video_id": { "type": "string", "minLength": 1 },
          "original_frame_id": { "type": ["integer", "null"], "minimum": 0 },
          "video_object_key": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "raw_score": { "type": "number" },
          "original_frame_id": { "type": ["integer", "null"], "minimum": 0 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "preview_uri": { "type": "string", "pattern": "^(file|s3|r2|gs|azure|https?)://[^\\s?#]+$" },
          "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "matched_terms": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "deadline_ms": { "type": "integer", "minimum": 1 },
    "index_version": { "type": "string", "minLength": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_mode", "normalized_query", "candidate_count", "scoring_components"],
      "properties": {
        "retrieval_mode": { "type": "string", "minLength": 1 },
        "normalized_query": { "type": "string" },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "scoring_components": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "recoverable": { "type": "boolean" }
      }
    }
  }
}

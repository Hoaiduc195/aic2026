{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/keyframe/schema.json",
  "title": "RetrievalKeyframe",
  "description": "A source-aligned sparse frame selected for retrieval. It never replaces the canonical source-frame manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_id",
    "original_frame_id",
    "timestamp_ms",
    "storage_uri",
    "retrieval_roles",
    "quality_scores",
    "quality_route",
    "selected_for_retrieval"
  ],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "original_frame_id": { "type": "integer", "minimum": 0 },
    "decoded_frame_index": { "type": "integer", "minimum": 0 },
    "timestamp_ms": { "type": "number", "minimum": 0 },
    "storage_uri": { "type": "string", "pattern": "^(file|s3|r2|https?)://[^\\s@?#]+$" },
    "shot_id": { "type": ["integer", "string", "null"] },
    "shot_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "n": { "type": "integer", "minimum": 1 },
    "pts": { "type": ["integer", "null"] },
    "frame_idx": { "type": "integer", "minimum": 0 },
    "pts_time": { "type": "number" },
    "fps": { "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" },
    "path": { "type": "string", "minLength": 1 },
    "source_storage_uri": { "type": "string", "pattern": "^(file|s3|r2)://[^\\s@?#]+$" },
    "frame_id": { "type": "string", "description": "Optional legacy opaque identifier." },
    "retrieval_role": {
      "enum": [
        "shot_anchor",
        "uniform_anchor",
        "shot_boundary",
        "scene_change_peak",
        "motion_peak",
        "text_change_peak",
        "cluster_medoid"
      ]
    },
    "retrieval_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "shot_anchor",
          "uniform_anchor",
          "shot_boundary",
          "scene_change_peak",
          "motion_peak",
          "text_change_peak",
          "cluster_medoid"
        ]
      }
    },
    "quality_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brightness_score", "blur_score", "contrast_score", "entropy_score"],
      "properties": {
        "brightness_score": { "type": "number" },
        "blur_score": { "type": "number", "minimum": 0 },
        "contrast_score": { "type": "number", "minimum": 0 },
        "entropy_score": { "type": "number", "minimum": 0 },
        "motion_score": { "type": "number", "minimum": 0 },
        "scene_change_score": { "type": "number", "minimum": 0 },
        "text_change_score": { "type": "number", "minimum": 0 }
      }
    },
    "quality_route": { "enum": ["retrieval_embedding", "temporal_only"] },
    "quality_reason": { "type": "string" },
    "selected_for_retrieval": { "type": "boolean" },
    "eligible_for_embedding": { "type": "boolean" },
    "quality_ok": { "type": "boolean" },
    "brightness_score": { "type": "number" },
    "blur_score": { "type": "number", "minimum": 0 },
    "contrast_score": { "type": "number", "minimum": 0 },
    "entropy_score": { "type": "number", "minimum": 0 },
    "brightness": { "type": "number" },
    "std_score": { "type": "number", "minimum": 0 }
    ,"pipeline_version": { "type": "string", "minLength": 1 }
    ,"schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
    ,"source_frame_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_id", "original_frame_id"],
      "properties": {
        "video_id": { "type": "string", "minLength": 1 },
        "original_frame_id": { "type": "integer", "minimum": 0 },
        "timestamp_ms": { "type": "number", "minimum": 0 }
      }
    }
    ,"selection_provenance": { "type": "object", "additionalProperties": true }
    ,"evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/keyframe/schema.json",
  "title": "Keyframe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_id",
    "segment_id",
    "frame_id",
    "timestamp_ms",
    "storage_uri",
    "quality_scores"
  ],
  "properties": {
    "video_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": "string", "minLength": 1 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "storage_uri": { "type": "string", "pattern": "^(s3|gs|azure|https?)://" },
    "quality_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brightness", "blur_score", "std_score"],
      "properties": {
        "brightness": { "type": "number" },
        "blur_score": { "type": "number" },
        "std_score": { "type": "number" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/processing_run/schema.json",
  "title": "ProcessingRun",
  "description": "Reproducible execution record for one pipeline stage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "dataset_id", "dataset_version", "stage", "pipeline_version", "schema_version", "config_hash", "model_versions", "status", "started_at", "finished_at", "input_artifact_ids", "output_artifact_ids", "errors"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "config_hash": { "type": "string", "minLength": 1 },
    "model_versions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "status": { "type": "string", "enum": ["pending", "running", "completed", "failed", "cancelled"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "input_artifact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "output_artifact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "recoverable"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "recoverable": { "type": "boolean" },
          "video_id": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "metrics": { "type": "object", "additionalProperties": true }
  }
}

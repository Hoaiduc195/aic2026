{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/frame/schema.json",
  "title": "CanonicalSourceFrame",
  "description": "One row in the complete zero-based decoded source-frame timeline. PTS is preferred for time; exact CFR time is retained only as a fallback/diagnostic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_id",
    "original_frame_id",
    "decoded_frame_index",
    "pts",
    "time_base_num",
    "time_base_den",
    "fps_num",
    "fps_den",
    "raw_pts_timestamp_ms",
    "pts_origin_ms",
    "pts_timestamp_ms",
    "cfr_timestamp_ms",
    "timestamp_ms",
    "timestamp_source",
    "is_codec_keyframe",
    "decode_status",
    "width",
    "height",
    "brightness_score",
    "blur_score",
    "contrast_score",
    "entropy_score",
    "motion_score",
    "scene_change_score",
    "text_change_score"
  ],
  "properties": {
    "video_id": { "type": "string", "minLength": 1 },
    "original_frame_id": { "type": "integer", "minimum": 0 },
    "decoded_frame_index": { "type": "integer", "minimum": 0 },
    "pts": { "type": ["integer", "null"] },
    "time_base_num": { "type": ["integer", "null"], "minimum": 1 },
    "time_base_den": { "type": ["integer", "null"], "minimum": 1 },
    "fps_num": { "type": ["integer", "null"], "minimum": 1 },
    "fps_den": { "type": ["integer", "null"], "minimum": 1 },
    "raw_pts_timestamp_ms": { "type": ["number", "null"] },
    "pts_origin_ms": { "type": ["number", "null"] },
    "pts_timestamp_ms": { "type": ["number", "null"], "minimum": 0 },
    "cfr_timestamp_ms": { "type": ["number", "null"], "minimum": 0 },
    "timestamp_ms": { "type": ["number", "null"], "minimum": 0 },
    "timestamp_source": { "enum": ["pts", "cfr_fallback", "unavailable"] },
    "is_codec_keyframe": { "type": "boolean" },
    "decode_status": { "const": "success" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "brightness_score": { "type": "number" },
    "blur_score": { "type": "number", "minimum": 0 },
    "contrast_score": { "type": "number", "minimum": 0 },
    "entropy_score": { "type": "number", "minimum": 0 },
    "motion_score": { "type": "number", "minimum": 0 },
    "scene_change_score": { "type": "number", "minimum": 0 },
    "text_change_score": { "type": "number", "minimum": 0 }
  }
}

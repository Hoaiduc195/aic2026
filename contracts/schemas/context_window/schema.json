{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/context_window/schema.json",
  "title": "ContextWindow",
  "description": "A temporal context containing one or more source frames. Intervals are half-open: [start_ms, end_ms).",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_window_id", "video_id", "start_ms", "end_ms", "member_frame_ids", "granularity"],
  "properties": {
    "context_window_id": { "type": "string", "minLength": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 1 },
    "start_frame_id": { "type": ["integer", "null"], "minimum": 0 },
    "end_frame_id": { "type": ["integer", "null"], "minimum": 1 },
    "member_frame_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "micro_event_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "previous_context_window_id": { "type": ["string", "null"], "minLength": 1 },
    "next_context_window_id": { "type": ["string", "null"], "minLength": 1 },
    "overlap_ms": { "type": "integer", "minimum": 0 },
    "granularity": { "const": "context_window" },
    "source": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}

# Local backend proxy. Leave empty to stay on the frontend fixture/API routes.
BACKEND_API_URL=http://localhost:3001

# Browser-side API base. Keep `/api` for the bundled Next.js routes unless you host elsewhere.
NEXT_PUBLIC_API_BASE_URL=/api

# Local AIC media root used by lazy playback and same-video frame routes.
# Windows fallback in code is E:\aic2026, but set it explicitly for local/dev/E2E parity.
AIC_MEDIA_ROOT=E:\aic2026

# Required when serving a production build. Enter the same value in "Cài đặt".
AIC_MEDIA_ACCESS_TOKEN=replace-with-a-long-random-secret

# Unsafe production escape hatch for an isolated machine only. Keep disabled by default.
AIC_ALLOW_UNAUTHENTICATED_MEDIA=false

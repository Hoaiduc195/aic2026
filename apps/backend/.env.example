# Backend runtime
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Only applies when NODE_ENV=development; production/staging always require OPERATOR_TOKEN.
NODE_ENV=development
ALLOW_UNAUTHENTICATED_LOCAL=true
OPERATOR_TOKEN=

# PostgreSQL local/Docker. Runtime may use a pooled URL; migrations use the direct URL.
DATABASE_URL=
DATABASE_DIRECT_URL=

# Cloudflare R2 object storage; the retrieval core currently consumes URIs.
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_SIGNED_URL_TTL_SECONDS=900

# Optional default query encoder. It must use the same CLIPA checkpoint and 1024-dimensional space as the indexed image vectors.
# Expected response: {"embedding": number[1024]}. The frontend can override URL, token and timeout per search session.
EMBEDDING_SERVICE_URL=
EMBEDDING_SERVICE_TOKEN=
EMBEDDING_DIMENSIONS=1024

# Optional OpenAI-compatible text LLM used for VQA answer suggestions.
# The adapter appends /chat/completions to this base URL unless it is already present.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=128
LLM_TEMPERATURE=0

# Optional MoreVQA OpenAI-compatible vision model. It receives a signed R2 keyframe URL.
# VLM_ENABLED must be true to enable backend-default VLM calls and optional visual reranking.
# Frontend VLM settings can override these values for one request without storing the API key.
VLM_ENABLED=false
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
# Optional override when the general VLM model does not accept image input.
AGENT_WORKER_VLM_BASE_URL=https://api.openai.com/v1
AGENT_WORKER_VLM_API_KEY=
AGENT_WORKER_VLM_MODEL=
AGENT_WORKER_VLM_TIMEOUT_MS=45000
AGENT_WORKER_VLM_MAX_TOKENS=128
AGENT_WORKER_REASONING_EFFORT=low
AGENT_WORKER_IMAGE_DETAIL=low
VLM_TIMEOUT_MS=15000
VLM_TOP_K=15
VLM_WEIGHT=0.6
VLM_CONCURRENCY=5

# Agent worker: reuse stored CLIP frame vectors, call the local text encoder once per query,
# auto-reject/accept confident CLIP scores, and send only ambiguous frames to the VLM.
AGENT_CLIP_REJECT_BELOW=0.08
AGENT_CLIP_ACCEPT_ABOVE=0.42
AGENT_WORKER_LEASE_MS=60000
AGENT_WORKER_VLM_CONCURRENCY=2

# Exact source-frame preview. FFmpeg must be installed in the backend runtime/container.
FFMPEG_PATH=ffmpeg
FRAME_DECODE_TIMEOUT_MS=15000

# Version metadata returned by the API.
DATASET_ID=aic2026
DATASET_VERSION=local
PIPELINE_VERSION=preprocessing-artifacts
ARTIFACT_VERSION=preprocessing-artifacts
INDEX_VERSION=not-configured
INDEX_CHECKSUM=
VERSION_STATUS=staged
MODEL_VERSIONS_JSON={"visual":"vit-b-32-1024","caption":"florence-2-base","object":"yolo26n-coco"}
SCHEMA_VERSION=1.0.0
